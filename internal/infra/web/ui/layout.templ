package ui

import "github.com/rahacloud/wpfleet/internal/infra/web/ui/i18n"

// htmxConfig turns off what the Content-Security-Policy would block anyway:
// the inline indicator styles, eval and script tags in swapped content.
const htmxConfig = `{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true}`

// Layout is the page around every other page: the language and direction,
// the stylesheet and htmx, and the header with the language switch and
// sign-out.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang={ p.L.Code() } dir={ p.L.Dir() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ p.Title } · wpfleet</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx-2.0.11.min.js" defer></script>
			<script src="/static/htmx-ext-sse-2.2.4.min.js" defer></script>
		</head>
		<body>
			<header class="top">
				<a class="brand" href="/">wpfleet</a>
				if p.User != "" {
					<form method="post" action="/lang">
						<input type="hidden" name="csrf" value={ p.CSRF }/>
						<input type="hidden" name="return" value={ p.Return }/>
						<label for="lang">{ p.L.T(i18n.LanguageLabel) }</label>
						<select id="lang" name="lang">
							for _, l := range i18n.Supported() {
								<option value={ l.Code() } selected?={ l == p.L }>{ l.Name() }</option>
							}
						</select>
						<button type="submit">{ p.L.T(i18n.Change) }</button>
					</form>
					<span class="muted">{ p.User }</span>
					<form method="post" action="/auth/logout">
						<input type="hidden" name="csrf" value={ p.CSRF }/>
						<button type="submit" class="link">{ p.L.T(i18n.SignOut) }</button>
					</form>
				}
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// MessagePage says one thing: a refusal, an error, or that the person
// signed out.
templ MessagePage(p Page, m Message) {
	@Layout(p) {
		<h1>{ m.Title }</h1>
		<p class={ "message", templ.KV("bad", m.Bad) }>{ m.Text }</p>
		if m.Link != "" {
			<p><a href={ templ.SafeURL(m.Link) }>{ m.LinkText }</a></p>
		}
	}
}
