package ui

import "github.com/rahacloud/wpfleet/internal/infra/web/ui/i18n"

// SignInView is the sign-in page.
type SignInView struct {
	// LoginURL starts the sign-in with the provider and comes back to the
	// page the person asked for.
	LoginURL string
}

// SignInPage is what a person sees before they sign in: the brand, what
// the server is for in their words, and one button.
templ SignInPage(p Page, v SignInView) {
	@Layout(p) {
		<section class="wf-card wf-signin">
			if p.Brand.LogoURL != "" {
				// The heading below names the brand, so the logo is decoration
				// and a screen reader does not read the name twice.
				<img class="wf-signin-logo" src={ p.Brand.LogoURL } alt=""/>
			}
			<h1>{ p.L.T(i18n.SignInHeading, p.Brand.Name) }</h1>
			<p>{ p.L.T(i18n.SignInIntro) }</p>
			<p>
				<a class="wf-btn wf-btn-primary wf-btn-large" href={ templ.SafeURL(v.LoginURL) }>{ p.L.T(i18n.SignInButton) }</a>
			</p>
			<p class="wf-help">{ p.L.T(i18n.SignInHint) }</p>
			if p.Brand.SupportURL != "" {
				<p class="wf-help">
					{ p.L.T(i18n.SignInTrouble) }
					<a href={ templ.SafeURL(p.Brand.SupportURL) }>{ p.L.T(i18n.ContactSupport) }</a>
				</p>
			}
		</section>
	}
}
