package ui

import "github.com/rahacloud/wpfleet/internal/infra/web/ui/i18n"

// FleetPage is the grid of sites and environments.
templ FleetPage(p Page, v FleetView) {
	@Layout(p) {
		<h1>{ p.L.T(i18n.SitesTitle) }</h1>
		if len(v.Rows) == 0 {
			<p class="message">{ p.L.T(i18n.NoSites) }</p>
		} else {
			<div class="table-wrap">
				<table class="fleet">
					<thead>
						<tr>
							<th scope="col">{ p.L.T(i18n.SiteColumn) }</th>
							for _, env := range v.Envs {
								<th scope="col"><span class="ltr">{ env }</span></th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range v.Rows {
							<tr>
								<th scope="row"><span class="ltr">{ row.Site }</span></th>
								for _, cell := range row.Cells {
									<td class="cell">
										@fleetCell(p.L, cell)
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// fleetCell is one site in one environment of the grid. The commit, drift
// and last backup load after the page, so a slow cluster does not hold the
// grid back.
templ fleetCell(l i18n.Lang, c FleetCell) {
	if c.Visible {
		if c.Present {
			<a class="tag ltr" href={ templ.SafeURL(SitePath(c.Env, c.Site)) }>{ tagOrUnknown(l, c.Tag) }</a>
			<div class="meta">
				{ l.T(i18n.ReadyLabel) }:
				<span class="ltr">{ readyOrUnknown(l, c.Ready) }</span>
			</div>
			if c.NewerIn != "" {
				<div class="meta warn">{ l.T(i18n.NewerIn, c.NewerIn) }</div>
			}
			<div class="meta loading" hx-get={ ActionPath(c.Env, c.Site, "status") } hx-trigger="load" hx-swap="outerHTML">{ l.T(i18n.Loading) }</div>
		} else {
			<span class="muted">{ l.T(i18n.NotInEnvironment) }</span>
		}
	}
}

// CellStatusFragment is what a grid cell loads after the page.
templ CellStatusFragment(l i18n.Lang, s CellStatus) {
	<div class="meta">
		if s.Engineering {
			<div>
				{ l.T(i18n.CommitLabel) }:
				if s.Commit != "" {
					<code>{ s.Commit }</code>
					if s.Dirty {
						<span class="warn">{ l.T(i18n.UncommittedChanges) }</span>
					}
				} else {
					<span class="muted">{ l.T(i18n.Unknown) }</span>
				}
			</div>
			<div>
				{ l.T(i18n.DriftLabel) }:{ " " }
				@driftLabel(l, s.Drift)
			</div>
		}
		<div>
			{ l.T(i18n.LastBackup) }:{ " " }
			@lastBackup(l, s.BackupEnabled, s.LastBackup)
		</div>
	</div>
}

// driftLabel says whether a release matches the branch.
templ driftLabel(l i18n.Lang, d Drift) {
	switch d {
		case DriftNone:
			<span class="ok">{ l.T(i18n.DriftNone) }</span>
		case DriftChanged:
			<span class="warn">{ l.T(i18n.DriftChanged) }</span>
		case DriftNotInstalled:
			<span class="muted">{ l.T(i18n.DriftNotInstalled) }</span>
		default:
			<span class="muted">{ l.T(i18n.DriftUnknown) }</span>
	}
}
