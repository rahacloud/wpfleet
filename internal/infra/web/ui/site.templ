package ui

import (
	"time"

	"github.com/rahacloud/wpfleet/internal/infra/web/ui/i18n"
)

// SitePage is one site in one environment: what it runs, the actions the
// person may start, and, for people with deploy, the release, pods, history
// and diff.
templ SitePage(p Page, s SiteView) {
	@Layout(p) {
		<h1><span class="ltr">{ s.Site }</span> · <span class="ltr">{ s.Env }</span></h1>
		if s.Running != "" {
			<p class="message">{ p.L.T(i18n.RunningNow, s.Running.Label(p.L)) }</p>
		}
		<section class="card">
			<dl class="facts">
				<dt>{ p.L.T(i18n.AddressLabel) }</dt>
				<dd>
					if s.URL != "" {
						<a class="ltr" href={ templ.URL(s.URL) } rel="noreferrer noopener" target="_blank">{ s.Host }</a>
					} else {
						<span class="ltr">{ s.Host }</span>
					}
				</dd>
				<dt>{ p.L.T(i18n.VersionLabel) }</dt>
				<dd><span class="ltr">{ tagOrUnknown(p.L, s.Tag) }</span></dd>
				if s.PromoteFrom != "" && s.FromTag != s.Tag {
					<dt></dt>
					<dd class="warn">{ p.L.T(i18n.NewerIn, s.PromoteFrom) }: <span class="ltr">{ tagOrUnknown(p.L, s.FromTag) }</span></dd>
				}
				<dt>{ p.L.T(i18n.ReadyLabel) }</dt>
				<dd><span class="ltr">{ readyOrUnknown(p.L, s.Ready) }</span></dd>
				<dt>{ p.L.T(i18n.LastBackup) }</dt>
				<dd>
					@lastBackup(p.L, s.Backup.Enabled, s.Backup.LastSuccess)
				</dd>
			</dl>
		</section>
		@siteActions(p.L, s)
		if s.Engineering {
			@engineering(p.L, s)
		}
		<h2>{ p.L.T(i18n.BackupsTitle) }</h2>
		<div hx-get={ ActionPath(s.Env, s.Site, "backups") } hx-trigger="load" hx-swap="outerHTML" class="loading">{ p.L.T(i18n.Loading) }</div>
	}
}

// siteActions are the buttons the person's permissions allow; the others
// are not rendered at all.
templ siteActions(l i18n.Lang, s SiteView) {
	<div class="actions">
		if s.Perms.Login {
			<form method="post" action={ templ.SafeURL(ActionPath(s.Env, s.Site, "admin")) } target="_blank" rel="noreferrer noopener">
				<input type="hidden" name="csrf" value={ s.CSRF }/>
				<button type="submit" class="primary" data-action="login">{ l.T(i18n.OpenAdmin) }</button>
			</form>
		}
		if s.CanPublish {
			<form method="post" action={ templ.SafeURL(ActionPath(s.Env, s.Site, "promote")) }>
				<input type="hidden" name="csrf" value={ s.CSRF }/>
				<button type="submit" data-action="promote">{ l.T(i18n.Publish, s.PromoteFrom, s.Env) }</button>
			</form>
		}
		if s.Perms.Deploy {
			<form method="post" action={ templ.SafeURL(ActionPath(s.Env, s.Site, "deploy")) }>
				<input type="hidden" name="csrf" value={ s.CSRF }/>
				<button type="submit" data-action="deploy">{ l.T(i18n.DeployButton) }</button>
			</form>
		}
		if s.Perms.Backup {
			<form method="post" action={ templ.SafeURL(ActionPath(s.Env, s.Site, "backup")) }>
				<input type="hidden" name="csrf" value={ s.CSRF }/>
				<button type="submit" data-action="backup">{ l.T(i18n.BackUpNow) }</button>
			</form>
		}
	</div>
}

// engineering is the part of the site page for people with deploy.
templ engineering(l i18n.Lang, s SiteView) {
	<h2>{ l.T(i18n.ReleaseTitle) }</h2>
	<section class="card">
		if s.Release == nil {
			<p class="muted">{ l.T(i18n.NotInstalled) }</p>
		} else {
			<dl class="facts">
				<dt>{ l.T(i18n.RevisionLabel) }</dt>
				<dd>{ l.Int(s.Release.Revision) } <span class="badge ltr">{ s.Release.Status }</span></dd>
				<dt>{ l.T(i18n.CommitLabel) }</dt>
				<dd>
					if s.Release.Commit != "" {
						<code>{ s.Release.Commit }</code>
						if s.Release.Dirty {
							<span class="warn">{ l.T(i18n.UncommittedChanges) }</span>
						}
					} else {
						<span class="muted">{ l.T(i18n.Unknown) }</span>
					}
				</dd>
				<dt>{ l.T(i18n.UpdatedLabel) }</dt>
				<dd>{ l.Time(s.Release.Updated) }</dd>
				<dt>{ l.T(i18n.ImageLabel) }</dt>
				<dd><code class="ltr">{ s.Image }</code></dd>
				<dt>{ l.T(i18n.VolumeLabel) }</dt>
				<dd>
					<code class="ltr">{ s.Volume.Claim }</code>
					if s.Volume.Found {
						<span class="ltr">{ s.Volume.Phase } { s.Volume.Capacity } { s.Volume.StorageClass }</span>
					} else {
						<span class="warn">{ l.T(i18n.VolumeMissing) }</span>
					}
				</dd>
			</dl>
		}
	</section>
	<h2>{ l.T(i18n.PodsTitle) }</h2>
	if len(s.Pods) == 0 {
		<p class="muted">{ l.T(i18n.NoPods) }</p>
	} else {
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th>{ l.T(i18n.PodLabel) }</th>
						<th>{ l.T(i18n.NodeLabel) }</th>
						<th>{ l.T(i18n.StateLabel) }</th>
						<th>{ l.T(i18n.ReadyLabel) }</th>
					</tr>
				</thead>
				<tbody>
					for _, pod := range s.Pods {
						<tr>
							<td><code class="ltr">{ pod.Name }</code></td>
							<td><span class="ltr">{ pod.Node }</span></td>
							<td><span class="ltr">{ pod.Phase }</span></td>
							<td>{ yesNo(l, pod.Ready) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	<h2>{ l.T(i18n.DiffTitle) }</h2>
	<div hx-get={ ActionPath(s.Env, s.Site, "diff") } hx-trigger="load" hx-swap="outerHTML" class="loading">{ l.T(i18n.Loading) }</div>
	<h2>{ l.T(i18n.HistoryTitle) }</h2>
	<div hx-get={ ActionPath(s.Env, s.Site, "history") } hx-trigger="load" hx-swap="outerHTML" class="loading">{ l.T(i18n.Loading) }</div>
}

// lastBackup says when a backup last succeeded.
templ lastBackup(l i18n.Lang, enabled bool, last *time.Time) {
	if !enabled {
		<span class="muted">{ lastBackupText(l, enabled, last) }</span>
	} else if last == nil {
		<span class="warn">{ lastBackupText(l, enabled, last) }</span>
	} else {
		<span>{ lastBackupText(l, enabled, last) }</span>
	}
}

// DiffFragment is what a deploy would change, loaded into the site page.
templ DiffFragment(l i18n.Lang, d DiffView) {
	<div>
		switch  {
			case d.Error != "":
				<p class="bad">{ l.T(i18n.DiffUnavailable, d.Error) }</p>
			case !d.Installed:
				<p class="muted">{ l.T(i18n.NotInstalled) }</p>
			case !d.Changed:
				<p class="ok">{ l.T(i18n.NoDiff) }</p>
		}
		if d.Diff != "" {
			<pre>{ d.Diff }</pre>
		}
	</div>
}

// HistoryFragment is the Git history of the site's file.
templ HistoryFragment(l i18n.Lang, entries []HistoryEntry, failed bool) {
	<div>
		if failed {
			<p class="bad">{ l.T(i18n.HistoryUnavailable) }</p>
		} else if len(entries) == 0 {
			<p class="muted">{ l.T(i18n.NoHistory) }</p>
		} else {
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>{ l.T(i18n.WhenLabel) }</th>
							<th>{ l.T(i18n.AuthorLabel) }</th>
							<th>{ l.T(i18n.ChangeLabel) }</th>
							<th>{ l.T(i18n.CommitLabel) }</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range entries {
							<tr>
								<td>{ l.Time(e.When) }</td>
								<td>{ e.Author }</td>
								<td>{ e.Subject }</td>
								<td><code>{ e.SHA }</code></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// BackupsFragment lists a site's backups, with a restore form on each for
// people with restore.
templ BackupsFragment(l i18n.Lang, b BackupsView) {
	<div>
		if b.Off && len(b.Rows) == 0 {
			<p class="muted">{ l.T(i18n.BackupsOff) }</p>
		} else if b.Failed {
			<p class="bad">{ l.T(i18n.BackupsUnavailable) }</p>
		} else if len(b.Rows) == 0 {
			<p class="muted">{ l.T(i18n.NoBackups) }</p>
		} else {
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>{ l.T(i18n.TakenLabel) }</th>
							<th>{ l.T(i18n.DatabaseLabel) }</th>
							<th>{ l.T(i18n.ChangedFilesLabel) }</th>
							<th>{ l.T(i18n.KeptUntilLabel) }</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range b.Rows {
							<tr>
								<td>
									{ l.Time(r.Taken) }
									if b.CanRestore && r.HasDump {
										@restoreForm(l, b, r)
									}
								</td>
								<td>
									if r.HasDump {
										{ l.Bytes(r.DumpSize) }
									} else {
										<span class="muted">—</span>
									}
								</td>
								<td>{ l.Int(r.ChangedFiles) }</td>
								<td>{ l.Time(r.Expires) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// restoreForm restores one backup after the site's name is typed; the
// server checks the name again.
templ restoreForm(l i18n.Lang, b BackupsView, r BackupRow) {
	<details class="restore">
		<summary>{ l.T(i18n.RestoreButton) }</summary>
		<form method="post" action={ templ.SafeURL(ActionPath(b.Env, b.Site, "restore")) }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			<input type="hidden" name="stamp" value={ r.Stamp }/>
			<label>
				<input type="checkbox" name="uploads" value="1"/>
				{ l.T(i18n.RestoreUploads) }
			</label>
			<label for={ "confirm-" + r.Stamp }>{ l.T(i18n.RestoreConfirm, b.Site) }</label>
			<input id={ "confirm-" + r.Stamp } type="text" name="confirm" required autocomplete="off" dir="ltr" pattern={ b.Site }/>
			<button type="submit" class="danger" data-action="restore">{ l.T(i18n.RestoreButton) }</button>
		</form>
	</details>
}
